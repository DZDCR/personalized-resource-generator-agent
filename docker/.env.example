# 复制为 .env 后修改；docker compose 会自动读取同目录 .env
# 仅上传相关变量，其余基础设施配置见 docker-compose.yml

# RustFS 访问密钥（生产必须替换，长度建议 >= 16）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=learning-uploads

# 上传凭证 HMAC 密钥（生产必须替换为 32 字节以上随机串）
UPLOAD_SIGNING_KEY=dev-only-change-me-please-32bytes

# 单文件上限（字节），默认 5GiB，需与 tusd -max-size 一致
UPLOAD_MAX_SIZE=5368709120
